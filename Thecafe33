<!DOCTYPE html><html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt chỗ - The Cafe 33</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 500px;
            margin: auto;
            padding: 20px;
        }
        label {
            font-weight: bold;
        }
        input, select {
            width: 100%;
            padding: 8px;
            margin: 5px 0 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        button {
            background-color: #333;
            color: white;
            padding: 10px;
            border: none;
            width: 100%;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background-color: #555;
        }
    </style>
</head>
<body>
    <h2>Đặt chỗ tại The Cafe 33</h2>
    <form action="#" method="POST">
        <label for="soLuong">Bạn đi mấy người?</label>
        <input type="number" id="soLuong" name="soLuong" min="1" required><label for="hoTen">Họ tên người đặt</label>
    <input type="text" id="hoTen" name="hoTen" required>

    <label for="sdt">Số điện thoại người đặt</label>
    <input type="tel" id="sdt" name="sdt" required>

    <label for="hoTen2">Họ tên người đi cùng</label>
    <input type="text" id="hoTen2" name="hoTen2">

    <label for="sdt2">Số điện thoại người đi cùng</label>
    <input type="tel" id="sdt2" name="sdt2">

    <label for="ngayDat">Ngày đặt</label>
    <input type="date" id="ngayDat" name="ngayDat" required>

    <label for="gioDat">Giờ đặt</label>
    <input type="time" id="gioDat" name="gioDat" required>

    <label for="gioKetThuc">Giờ kết thúc dự kiến</label>
    <input type="time" id="gioKetThuc" name="gioKetThuc" required>

    <label>
        <input type="checkbox" id="dongY" name="dongY" required>
        Tôi đồng ý với quy định của The Cafe 33
    </label>

    <button type="submit">Đặt chỗ</button>
</form>

</body>
</html>
