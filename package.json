{
  "name": "oc-eo-townwalk",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "esbuild assets/firebase-sdk.js --bundle --minify --format=esm --outfile=assets/vendor/firebase.js --legal-comments=linked",
    "test": "node --test tests/model.test.mjs",
    "test:functions": "node --test tests/functions.test.mjs",
    "test:firebase": "firebase emulators:exec --config firebase.emulators.json --project demo-oceo-townwalk --only auth,firestore,storage,functions \"node --test --test-concurrency=1 tests/emulators.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.25.12",
    "firebase-tools": "15.34.2"
  },
  "dependencies": {
    "firebase": "13.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
